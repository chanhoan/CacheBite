{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CacheBite",
  "version": "0.1.0",
  "identifier": "dev.cachebite.app",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/pets/*/frames/*.png"]
      }
    },
    "windows": [
      {
        "label": "overlay",
        "url": "index.html?window=overlay",
        "title": "CacheBite",
        "width": 240,
        "height": 240,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "panel",
        "url": "index.html?window=panel",
        "title": "CacheBite Usage",
        "width": 312,
        "height": 520,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/pets/**/*"],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwQ0RGOUY5NkE0OTNBQ0UKUldUT09rbHErZm5OY0pzYllJT0svOFdDQmtTZUJ5Q2dzekNEZ1ZRSFJZeHIzamVjZmozWHhUTlcK",
      "endpoints": [
        "https://github.com/chanhoan/CacheBite/releases/download/updater/stable.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
