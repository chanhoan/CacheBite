{
  "name": "cachebite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "wdio run ./wdio.conf.ts",
    "test:e2e:renderer": "wdio run ./wdio.browser.conf.ts",
    "test:ci": "svelte-check --tsconfig ./tsconfig.json && eslint . && prettier --check . && vitest run --coverage && vite build",
    "audit:ci": "corepack pnpm audit --audit-level high",
    "licenses:check": "corepack pnpm licenses list --prod --json",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tauri-apps/api": "2.8.0",
    "@tauri-apps/plugin-notification": "2.3.3"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@sveltejs/vite-plugin-svelte": "6.1.3",
    "@tauri-apps/cli": "2.8.4",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/svelte": "5.2.8",
    "@types/node": "24.3.0",
    "@vitest/coverage-v8": "3.2.7",
    "@wdio/cli": "9.29.1",
    "@wdio/local-runner": "9.29.1",
    "@wdio/mocha-framework": "9.29.1",
    "@wdio/spec-reporter": "9.29.1",
    "@wdio/tauri-service": "1.0.0",
    "eslint": "9.34.0",
    "eslint-plugin-svelte": "3.12.2",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.4.0",
    "svelte": "5.38.7",
    "svelte-check": "4.3.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "overrides": {
      "serialize-javascript": "7.0.3"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mh99-v99m-4gvg"
      ]
    }
  }
}
